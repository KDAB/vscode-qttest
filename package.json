{
  "name": "qttests",
  "displayName": "QtTest Runner",
  "description": "Extension to list and run individual QtTest slots",
  "version": "1.14.0",
  "publisher": "KDAB",
  "repository": {
    "type": "git",
    "url": "https://github.com/KDAB/vscode-qttest.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:*.cpp",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node esbuild.js",
    "watch:bundle": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "pretest": "tsc -p tsconfig.test.json && npm run bundle && npm run lint",
    "test": "vscode-test",
    "lint": "eslint src/ --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "mocha": "^12.0.1",
    "prettier": "3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "tap-parser": "^18.3.4",
    "vscode-cmake-tools": "^1.7.0"
  },
  "extensionDependencies": [
    "ms-vscode.cmake-tools"
  ],
  "keywords": [
    "KDAB",
    "QTest",
    "QtTest"
  ],
  "icon": "kdab.png",
  "contributes": {
    "configuration": {
      "title": "KDAB QtTest",
      "properties": {
        "KDAB.QtTest.CheckTestLinksToQtTestLib": {
          "type": "boolean",
          "default": false,
          "description": "Calls ldd on the test executable to make sure it's a QtTest. Only implemented on Linux. Use if you also have non-Qt tests."
        },
        "KDAB.QtTest.debugger": {
          "type": "string",
          "enum": [
            "default",
            "ms-vscode.cpptools lldb",
            "ms-vscode.cpptools msvc",
            "ms-vscode.cpptools gdb",
            "CodeLLDB",
            "KDAB DAP gdb",
            "KDAB DAP lldb",
            "Existing Launch"
          ],
          "enumDescriptions": [
            "Uses KDAB DAP if installed (gdb on Linux if it's 16.1 or later, LLDB on macOS), otherwise VS on Windows, gdb on Linux and LLDB on macOS",
            "LLDB via Microsoft C++ extension",
            "VS debugger via Microsoft C++ extension",
            "GDB via Microsoft C++ extension",
            "LLDB debugger via CodeLLDB extension",
            "GDB (16.1 or later) via KDAB DAP extension",
            "LLDB via KDAB DAP extension",
            "Use an existing launch configuration"
          ],
          "default": "default",
          "description": "Which debugger to use"
        }
      }
    },
    "commands": [
      {
        "command": "KDAB.qttest.debugTest",
        "title": "Debug selection..."
      },
      {
        "command": "KDAB.qttest.installGdbPrettyPrinters",
        "title": "Install gdb Qt pretty printers"
      }
    ],
    "submenus": [
      {
        "id": "kdab.qttest.menu",
        "label": "QtTest"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == cpp && !inDebugMode && editorHasSelection && debuggersAvailable",
          "group": "qttest",
          "submenu": "kdab.qttest.menu"
        }
      ],
      "kdab.qttest.menu": [
        {
          "command": "KDAB.qttest.debugTest"
        }
      ],
      "commandPalette": [
        {
          "command": "KDAB.qttest.installGdbPrettyPrinters",
          "when": "isLinux"
        }
      ]
    }
  }
}
